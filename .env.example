# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key used by the seeder (bypasses RLS). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public key for the game client later (can only call the exposed functions).
SUPABASE_ANON_KEY=
