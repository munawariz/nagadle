{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/forms/**",
              "components/frames/**",
              "components/icon/**",
              "components/progress/**",
              "components/surfaces/**",
              "ui_kits/daily-game/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:M PLUS Rounded 1c))/i]",
        "message": "Font not provided by the design system. Available: M PLUS Rounded 1c."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|variant|direction|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: children, href, variant, direction, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|chip)$/]",
        "message": "<ArrowLink> variant must be one of 'plain' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:back|forward)$/]",
        "message": "<ArrowLink> direction must be one of 'back' | 'forward'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|danger|warn|moss)$/]",
        "message": "<Button> variant must be one of 'primary' | 'danger' | 'warn' | 'moss'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|media|meta|action|active|interactive|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, description, media, meta, action, active, interactive, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|placeholder|error|disabled|type|id|onChange|onKeyDown|inputStyle|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, defaultValue, placeholder, error, disabled, type, id, onChange, onKeyDown, inputStyle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|search|password)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'search' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mascot'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|size|bob|alt|style|key|ref|className|style|children)$/]",
        "message": "<Mascot> doesn't accept that prop. Declared props: src, size, bob, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeechBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tail|tone|tailOffset|style|key|ref|className|style|children)$/]",
        "message": "<SpeechBubble> doesn't accept that prop. Declared props: children, tail, tone, tailOffset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeechBubble'] > JSXAttribute[name.name='tail'] > Literal[value!=/^(?:bottom-left|bottom-center|left)$/]",
        "message": "<SpeechBubble> tail must be one of 'bottom-left' | 'bottom-center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeechBubble'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|moss)$/]",
        "message": "<SpeechBubble> tone must be one of 'white' | 'moss'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|size|orientation|style|key|ref|className|style|children)$/]",
        "message": "<StepDots> doesn't accept that prop. Declared props: steps, size, orientation, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepDots'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<StepDots> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|accent|size|ink|style|key|ref|className|style|children)$/]",
        "message": "<TextFrame> doesn't accept that prop. Declared props: children, variant, accent, size, ink, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextFrame'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:overlap|stroke|box|strokeInside|dotted|striped|sticky|rounded|tape|memo|fold|ribbon|flag|browser|pixel|pin|clip|diamonds|circles|separate|offset3d)$/]",
        "message": "<TextFrame> variant must be one of 'overlap' | 'stroke' | 'box' | 'strokeInside' | 'dotted' | 'striped' | 'sticky' | 'rounded' | 'tape' | 'memo' | 'fold' | 'ribbon' | 'flag' | 'browser' | 'pixel' | 'pin' | 'clip' | 'diamonds' | 'circles' | 'separate' | 'offset3d'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextFrame'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:lime|red|yellow|moss)$/]",
        "message": "<TextFrame> accent must be one of 'lime' | 'red' | 'yellow' | 'moss'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|amplitude|wavelength|thickness|style|key|ref|className|style|children)$/]",
        "message": "<WaveLine> doesn't accept that prop. Declared props: tone, width, amplitude, wavelength, thickness, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:next|done)$/]",
        "message": "<WaveLine> tone must be one of 'next' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WavePattern'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|height|cell|children|style|key|ref|className|style|children)$/]",
        "message": "<WavePattern> doesn't accept that prop. Declared props: tone, height, cell, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WavePattern'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lime|red|moss|cream)$/]",
        "message": "<WavePattern> tone must be one of 'lime' | 'red' | 'moss' | 'cream'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
